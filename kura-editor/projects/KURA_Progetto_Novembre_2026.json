    {
      "id": "kura-nov26-03",
      "name": "Sudafrica · Kruger",
      "seed": "30254",
      "layout": 3,
      "background": 3,
      "backgroundId": "basic_4",
      "seasonHint": "autumn",
      "note": 2,
      "fields": {
        "eyebrow": "03 / SUDAFRICA",
        "head1": "Quando la savana",
        "body1": "Se pensi alla savana africana, probabilmente ti vengono in mente distese gialle, polvere e leoni all'ombra degli alberi. Ecco, a novembre il **Kruger** comincia a cambiare completamente faccia.\n\nArrivano le prime **piogge**, spunta il **verde**, tornano tantissimi **uccelli migratori** e gli **impala** iniziano a partorire i loro piccoli. Insomma, c'è parecchio movimento!",
        "head2": "torna verde",
        "body2": "E poi vuoi mettere partire per un **safari all'alba**, con la savana tutta verde, gli uccelli che si fanno sentire ovunque e magari la fortuna di vedere un **cucciolo** muovere i suoi primi passi? È uno di quei periodi in cui la natura sembra svegliarsi tutta insieme. E secondo noi vale davvero la pena esserci!",
        "base": "Campi nel parco o nei dintorni",
        "duration": "4–5 giorni",
        "highlight": "Safari all'alba e birdwatching",
        "tips": "Caldo, piogge e tanta vegetazione",
        "label_highlight": "Da vivere"
      },
