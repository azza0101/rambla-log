{
  "name": "KURA Carousel Editor",
  "apiVersion": "3.0.0",
  "browserNamespace": "window.KURA_MCP",
  "format": "KURA_EDITOR_V2",
  "units": {
    "canvas": "px",
    "width": 1080,
    "height": 1350,
    "rotation": "degrees",
    "background": "0..15, prefer backgroundId",
    "opacity": "0..1",
    "scale": "ratio"
  },
  "storage": {
    "mechanism": "IndexedDB device-local",
    "autosave": "650ms debounce",
    "crossDevice": "JSON export/import only; no server sync"
  },
  "pageIdentity": "pages[].id is stable and independent of page index. Free text blocks have freeTexts[].id. Use pageId when possible.",
  "textFields": [
    "eyebrow",
    "head1",
    "body1",
    "head2",
    "body2",
    "label_base",
    "base",
    "label_duration",
    "duration",
    "label_highlight",
    "highlight",
    "label_tips",
    "tips"
  ],
  "fontFamilies": [
    "Montserrat",
    "Kaushan Script",
    "Caveat Brush",
    "KURA Brush2",
    "Caveat"
  ],
  "patchOperations": {
    "setText": {
      "required": [
        "op",
        "pageId|pageIndex",
        "key"
      ],
      "optional": [
        "text",
        "style"
      ],
      "styleKeys": [
        "fontSize",
        "family",
        "bold",
        "color",
        "lineHeight"
      ]
    },
    "setBackground": {
      "required": [
        "op",
        "pageId|pageIndex",
        "background"
      ],
      "note": "background 0..3 original bitmap; 4..11 generated paper"
    },
    "addText": {
      "required": [
        "op",
        "pageId|pageIndex",
        "text"
      ],
      "optional": [
        "x",
        "y",
        "w",
        "h",
        "rot",
        "style"
      ]
    },
    "moveElement": {
      "required": [
        "op",
        "pageId|pageIndex",
        "id"
      ],
      "optional": [
        "x",
        "y",
        "dx",
        "dy",
        "w",
        "h",
        "rot",
        "scale",
        "opacity"
      ],
      "elementId": "text:<field>, text:free:<id>, scene, postcard, note, sticker:<id>"
    },
    "setPageName": {
      "required": [
        "op",
        "pageId|pageIndex",
        "name"
      ]
    },
    "addPage": {
      "required": [
        "op"
      ],
      "optional": [
        "layout",
        "name"
      ]
    },
    "setBackgroundId": {
      "required": [
        "op",
        "pageId|pageIndex",
        "backgroundId"
      ],
      "backgroundIds": [
        "basic_1",
        "basic_2",
        "basic_3",
        "basic_4",
        "spring_1",
        "spring_2",
        "spring_3",
        "summer_1",
        "summer_2",
        "summer_3",
        "autumn_1",
        "autumn_2",
        "autumn_3",
        "winter_1",
        "winter_2",
        "winter_3"
      ]
    },
    "setSeason": {
      "required": [
        "op",
        "pageId|pageIndex",
        "season"
      ],
      "seasons": [
        "basic",
        "spring",
        "summer",
        "autumn",
        "winter",
        "auto"
      ]
    },
    "addSticker": {
      "required": [
        "op",
        "pageId|pageIndex",
        "key"
      ],
      "optional": [
        "x",
        "y",
        "w",
        "rot",
        "scale"
      ],
      "keys": [
        "olive",
        "berries",
        "monstera",
        "map",
        "compass",
        "stamp",
        "tape",
        "camera",
        "spring_blossom_branch",
        "spring_blossom_cluster",
        "spring_tulips",
        "spring_pink_petals",
        "summer_lemon_branch",
        "summer_orange_slices",
        "summer_paper_shell",
        "summer_swallow",
        "autumn_maple_leaf",
        "autumn_purple_grapes",
        "autumn_olive_branch",
        "autumn_wheat",
        "winter_paper_snowflake",
        "winter_snowy_pine",
        "winter_pine_cones",
        "winter_holly_branch"
      ]
    },
    "loadTemplate": {
      "call": "await window.KURA_MCP.loadTemplate('novembre-2026')",
      "createsSeparateProject": true,
      "preservesExistingProjects": true,
      "reopeningRestoresLocallyEditedVersion": true
    }
  },
  "workflow": [
    "Read KURA_MCP.inspect() for page IDs and text keys",
    "Read KURA_MCP.getProject() to inspect/edit data",
    "Call KURA_MCP.applyPatch(operations) for in-browser updates",
    "Call KURA_MCP.save() to persist immediately",
    "Use KURA_MCP.exportJSON() or UI for file transfer"
  ],
  "examplePatch": [
    {
      "op": "setText",
      "pageIndex": 0,
      "key": "head1",
      "text": "La magia della neve",
      "style": {
        "family": "Feeling Passionate",
        "fontSize": 48,
        "color": "#cf7931"
      }
    },
    {
      "op": "setText",
      "pageIndex": 0,
      "key": "body1",
      "text": "Un viaggio tra **vigneti** e borghi.",
      "style": {
        "fontSize": 30
      }
    },
    {
      "op": "setBackground",
      "pageIndex": 0,
      "background": 6
    },
    {
      "op": "addText",
      "pageIndex": 0,
      "text": "Un dettaglio",
      "x": 500,
      "y": 900,
      "w": 380,
      "h": 80,
      "style": {
        "fontSize": 32,
        "bold": true
      }
    },
    {
      "op": "moveElement",
      "pageIndex": 0,
      "id": "text:head1",
      "dx": 16,
      "dy": -15,
      "rot": -5,
      "scale": 1.05
    }
  ],
  "notes": [
    "Bold spans use **testo** markup and are stored in fields: no HTML injection into data.",
    "window.KURA_MCP is an in-browser automation interface, NOT a remote MCP server. External MCP clients need browser execution, file editing, or a server bridge.",
    "The proprietary Feeling Passionate font is not bundled; to serve all users, provide a properly licensed web/app font at assets/FeelingPassionate.woff2.",
    "Illustrated background SVGs and 9 new stickers are first-party static assets under assets/.",
    "Seasonal background ids are stable; prefer named backgroundId over numeric index.",
    "KURA 2.5 stores 16 high-quality photographic papercut WebP stickers separately, 4 per season, not simplified SVG substitutes.",
    "KURA November 2026 uses three independent papercut Giulia PNG layers and three landscapes in fixed asset registry. The template imports directly from GitHub Pages and remains editable, with autosave and PNG/ZIP export."
  ],
  "backgroundPresets": [
    {
