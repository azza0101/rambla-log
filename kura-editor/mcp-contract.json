      "path": "./assets/sfondo_winter_3_paper_v3.svg"
    }
  ],
  "stickers": [
    "olive",
    "berries",
    "monstera",
    "map",
    "compass",
    "stamp",
    "tape",
    "camera",
    "spring_blossom_branch",
    "spring_blossom_cluster",
    "spring_tulips",
    "spring_pink_petals",
    "summer_lemon_branch",
    "summer_orange_slices",
    "summer_paper_shell",
    "summer_swallow",
    "autumn_maple_leaf",
    "autumn_purple_grapes",
    "autumn_olive_branch",
    "autumn_wheat",
    "winter_paper_snowflake",
    "winter_snowy_pine",
    "winter_pine_cones",
    "winter_holly_branch"
  ],
  "fontAssets": [
    {
      "name": "Kaushan Script",
      "file": "./assets/KaushanScript-Regular.ttf",
      "license": "SIL OFL 1.1",
      "defaultBrush": true
    },
    {
      "name": "Caveat Brush",
      "file": "./assets/CaveatBrush-Regular.ttf",
      "license": "SIL OFL 1.1",
      "defaultBrush": false
    }
  ],
  "postit": {
    "autoHeight": true,
    "stretchStrategy": "native-scale icon/header rows; repeat blank-paper slices after rows for text overflow; no stretching printed icons",
    "marginLeftPercent": 40.5,
    "marginRightPercent": 13,
    "contentRotation": "all note text uses common rotation pivot as paper",
    "autoLineWrap": true
  },
  "dragAndDrop": {
    "desktop": "drag sticker from library onto canvas",
    "mobile": "touch drag within viewport or tap then reposition",
    "mcp": "addSticker and moveElement operations"
  },
  "typography": {
    "heading": {
      "family": "KURA Brush2",
      "fontSize": 40,
      "bold": false,
      "strokeWidth": 0.85,
      "description": "weight intermediate between normal light and synthetic bold"
    },
    "underline": "orange stroke centered vertically beside heading"
  },
  "transformControls": {
    "allEditableElements": true,
    "directControls": [
      "move",
      "rotate",
      "resize free width and height",
      "resize width only",
      "resize height only",
      "flipX",
      "flipY"
    ],
    "canvasCoordinates": "1080×1350",
    "savedKeys": [
      "x",
      "y",
      "dx",
      "dy",
      "w",
      "h",
      "rot",
      "scale",
      "scaleX",
      "scaleY",
      "flipX",
      "flipY"
    ],
    "note": "Text widths and heights may be absolute overrides in offsets. Images use independent scaleX/scaleY ratios."
  },
  "uiControls": {
    "fontToolbar": "docked above canvas, never overlaps selection handles",
    "compactTransformHandles": {
      "pointerFinePx": 26,
      "pointerCoarsePx": 30
    },
    "brushTitleAccent": "small dash preceding each heading, optically centered vertically at approx. 44% of 40px title glyph height"
  },
  "templates": [
    {
      "id": "novembre-2026",
      "projectId": "kura-nov26-travel-pages-v3",
      "projectFile": "./projects/KURA_Progetto_Novembre_2026.json",
      "pageCount": 3,
      "GiuliaFullWidthBorders": [
        "giulia_vipacco_border.png",
        "giulia_maiorca_border.png",
        "giulia_kruger_border.png"
      ],
      "openUrl": "./?template=novembre-2026&v=3.0.0"
    }
  ],
  "projectActions": {
    "save": "topSaveProject: autosave IndexedDB + download portable JSON",
    "open": "topOpenProject: new project from uploaded JSON without overwriting existing",
    "autosave": true
  },
  "backgroundTransform": {
    "property": "pages[].bgTransform",
    "zoom": "1–1.8",
    "dx": "-300 to 300",
    "dy": "-300 to 300",
    "workflow": "Varianti > Dimensioni e posizione dello sfondo"
  },
  "noteText": {
    "fontSizes": {
      "labels": 21,
      "values": 21,
      "highlightTips": 19
    },
    "rotation": "note rot plus calibratable noteTextAngle",
    "margin": "retain approx 40.5% left (icon column), 13% right"
  }
}
